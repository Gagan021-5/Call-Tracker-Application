# =============================================================================
# Root .gitignore — Call Tracer App
# =============================================================================

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# -----------------------------------------------------------------------------
# Python / Django
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django local database & static/media
*.sqlite3
db.sqlite3-journal
media/
staticfiles/

# -----------------------------------------------------------------------------
# JavaScript / React Native / Expo
# -----------------------------------------------------------------------------
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Prebuild native generated folders
callapp/android/
callapp/ios/
.kotlin/
*.orig.*

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# IDE & System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
