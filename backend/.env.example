# =============================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# PostgreSQL Database Configuration
DB_NAME=calltracer_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Django Security Settings
SECRET_KEY=django-insecure-change-this-to-a-secure-random-string-for-production
DEBUG=True

# Allowed Hosts (comma-separated, e.g. "localhost,127.0.0.1,192.168.1.28")
ALLOWED_HOSTS=*

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ALL_ORIGINS=True
